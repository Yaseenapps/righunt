// Cloudflare deploy settings. The build command copies the site into public/
// (index.html, _headers, assets, data) and this uploads exactly that folder.
// Any address that is not a real file - /products/gpu, /saved - is answered
// with index.html, and the site's router shows the right page.
{
  "name": "righunt",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  }
}
